# Worker-owned Android Gradle runtime for the canonical XYZL Android workspace.
# This makes the formerly operator-only image reproducible by the deployment.
FROM docker.io/library/gradle:9.7.0-jdk21-jammy

USER root
ENV ANDROID_HOME=/opt/android-sdk \
    ANDROID_SDK_ROOT=/opt/android-sdk \
    PATH=/opt/android-sdk/cmdline-tools/latest/bin:/opt/android-sdk/platform-tools:${PATH}

RUN set -eu; \
    http_apt_proxy="${http_proxy:-${HTTP_PROXY:-}}"; \
    https_apt_proxy="${https_proxy:-${HTTPS_PROXY:-${http_apt_proxy}}}"; \
    set -- -o Acquire::Retries=3 -o Acquire::http::Timeout=30 -o Acquire::https::Timeout=30; \
    if [ -n "${http_apt_proxy}" ]; then set -- "$@" -o "Acquire::http::Proxy=${http_apt_proxy}"; fi; \
    if [ -n "${https_apt_proxy}" ]; then set -- "$@" -o "Acquire::https::Proxy=${https_apt_proxy}"; fi; \
    apt-get "$@" update; \
    DEBIAN_FRONTEND=noninteractive apt-get "$@" install -y --no-install-recommends ca-certificates curl unzip; \
    rm -rf /var/lib/apt/lists/*; \
    mkdir -p /opt/android-sdk/cmdline-tools; \
    curl -fsSL https://dl.google.com/android/repository/commandlinetools-linux-16111833_latest.zip -o /tmp/cmdline-tools.zip; \
    unzip -q /tmp/cmdline-tools.zip -d /tmp/android-cli; \
    mv /tmp/android-cli/cmdline-tools /opt/android-sdk/cmdline-tools/latest; \
    rm -rf /tmp/cmdline-tools.zip /tmp/android-cli; \
    yes | sdkmanager --licenses >/dev/null; \
    sdkmanager --install 'platform-tools' 'platforms;android-36' 'build-tools;36.0.0'; \
    chmod -R a+rX /opt/android-sdk

ARG TEMURIN25_URL=https://github.com/adoptium/temurin25-binaries/releases/download/jdk-25.0.3%2B9/OpenJDK25U-jdk_x64_linux_hotspot_25.0.3_9.tar.gz
ARG TEMURIN25_SHA_URL=https://github.com/adoptium/temurin25-binaries/releases/download/jdk-25.0.3%2B9/OpenJDK25U-jdk_x64_linux_hotspot_25.0.3_9.tar.gz.sha256.txt
RUN set -eu; \
    mkdir -p /usr/lib/jvm /tmp/jdk25; \
    curl -fsSL "${TEMURIN25_URL}" -o /tmp/jdk25.tar.gz; \
    curl -fsSL "${TEMURIN25_SHA_URL}" -o /tmp/jdk25.sha256; \
    cd /tmp; \
    sed -i 's#  .*#  jdk25.tar.gz#' jdk25.sha256; \
    sha256sum -c jdk25.sha256; \
    tar -xzf jdk25.tar.gz -C /tmp/jdk25; \
    extracted="$(find /tmp/jdk25 -mindepth 1 -maxdepth 1 -type d | head -1)"; \
    test -n "${extracted}"; \
    mv "${extracted}" /usr/lib/jvm/temurin-25-jdk-amd64; \
    rm -rf /tmp/jdk25 /tmp/jdk25.tar.gz /tmp/jdk25.sha256; \
    /usr/lib/jvm/temurin-25-jdk-amd64/bin/java -version

USER root
