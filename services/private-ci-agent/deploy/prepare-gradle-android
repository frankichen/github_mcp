#!/bin/bash
set -euo pipefail

if [ "$(id -u)" != "1500" ]; then
    echo "[android-gradle-image] run as ciworker (uid 1500)" >&2
    exit 2
fi
cd /tmp

BUILD_TMPDIR="${PRIVATE_CI_BUILD_TMPDIR:-/tmp}"
mkdir -p "${BUILD_TMPDIR}"
export TMPDIR="${BUILD_TMPDIR}" BUILDAH_TMPDIR="${BUILD_TMPDIR}"

AGENT_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
IMAGE="${PRIVATE_CI_ANDROID_GRADLE_IMAGE:-localhost/private-ci-gradle-android:9.7-jdk21-api36-jdk25-v3}"
BASE_IMAGE="docker.io/library/gradle:9.7.0-jdk21-jammy"

if [ -r /srv/private-ci/run/proxy.runtime.conf ]; then
    set -a
    # shellcheck source=/dev/null
    . /srv/private-ci/run/proxy.runtime.conf
    set +a
fi

CONTAINER_PROXY_HOST="${PRIVATE_CI_CONTAINER_PROXY_HOST:-10.0.2.2}"
rewrite_loopback_proxy_url() {
    local value="$1"
    value="${value//127.0.0.1/${CONTAINER_PROXY_HOST}}"
    value="${value//localhost/${CONTAINER_PROXY_HOST}}"
    value="${value//\[::1\]/${CONTAINER_PROXY_HOST}}"
    value="${value//::1/${CONTAINER_PROXY_HOST}}"
    printf '%s' "${value}"
}
for proxy_var in HTTP_PROXY HTTPS_PROXY ALL_PROXY http_proxy https_proxy all_proxy; do
    proxy_value="${!proxy_var:-}"
    if [ -n "${proxy_value}" ]; then
        export "${proxy_var}=$(rewrite_loopback_proxy_url "${proxy_value}")"
    fi
done

verify_image() {
    /usr/bin/podman run --rm --network none "${IMAGE}" /bin/sh -lc \
        'test -d /opt/android-sdk/platforms/android-36 && test -d /opt/android-sdk/build-tools/36.0.0 && test -x /usr/lib/jvm/temurin-25-jdk-amd64/bin/java && gradle --version >/dev/null'
}

if /usr/bin/podman image exists "${IMAGE}" 2>/dev/null; then
    verify_image
    echo "[android-gradle-image] ready image=${IMAGE} source=local-store"
    exit 0
fi
if ! /usr/bin/podman image exists "${BASE_IMAGE}" 2>/dev/null; then
    echo "[android-gradle-image] base image missing locally: ${BASE_IMAGE}" >&2
    exit 1
fi

context="$(mktemp -d /tmp/private-ci-gradle-android.XXXXXX)"
trap 'rm -rf "${context}"' EXIT
install -m 0644 "${AGENT_ROOT}/deploy/Dockerfile.gradle-android" "${context}/Dockerfile"

echo "[android-gradle-image] building shared image=${IMAGE}"
/usr/bin/buildah bud \
    --pull=never \
    --network=slirp4netns:allow_host_loopback=true \
    --tag "${IMAGE}" \
    --file "${context}/Dockerfile" \
    "${context}"

/usr/bin/podman image exists "${IMAGE}" || {
    echo "[android-gradle-image] image build did not produce ${IMAGE}" >&2
    exit 1
}
verify_image || {
    echo "[android-gradle-image] required Android/JDK runtime is unavailable" >&2
    exit 1
}
echo "[android-gradle-image] ready image=${IMAGE} source=local-store"
