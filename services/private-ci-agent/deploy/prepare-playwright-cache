#!/bin/bash
set -euo pipefail

# Run once as the private-ci rootless worker during a controlled maintenance
# window.  Normal jobs only consume this cache and never install browsers.
if [ "$(id -u)" != "1500" ]; then
    echo "[playwright-cache] run as ciworker (uid 1500)" >&2
    exit 2
fi

AGENT_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
CACHE_ROOT="/srv/private-ci/cache/ms-playwright"
NPM_CACHE="/srv/private-ci/cache/npm"
WORKSPACE_ROOT="/srv/private-ci/workspaces"

if [ -r /srv/private-ci/run/proxy.runtime.conf ]; then
    set -a
    # shellcheck source=/dev/null
    . /srv/private-ci/run/proxy.runtime.conf
    set +a
fi
# PodmanRunner maps CACHE_ROOT to the container target /ci-cache/ms-playwright.
MAINTENANCE_WORKSPACE="$(mktemp -d "${WORKSPACE_ROOT}/.playwright-maintenance.XXXXXX")"
trap 'rm -rf "${MAINTENANCE_WORKSPACE}"' EXIT

umask 077
mkdir -p "${CACHE_ROOT}" "${NPM_CACHE}"
chmod 700 "${CACHE_ROOT}" "${NPM_CACHE}" "${MAINTENANCE_WORKSPACE}"

PYTHONPATH="${AGENT_ROOT}" /usr/bin/python3 - "${MAINTENANCE_WORKSPACE}" "${NPM_CACHE}" "${CACHE_ROOT}" <<'PY'
import os
import sys
from pathlib import Path

from private_ci_agent.podman import PodmanRunner
from private_ci_agent.profiles import node_browser_image

workspace, npm_cache, browser_cache = sys.argv[1:]
result = PodmanRunner("/usr/bin/podman").run_command(
    node_browser_image(),
    f"playwright-maintenance-{os.getpid()}",
    workspace,
    {"npm": npm_cache, "playwright": browser_cache},
    "npx --yes playwright@1.62.0 install chromium --no-shell",
    900,
    network=True,
    # If a worker proxy is configured, PodmanRunner injects only its cleaned
    # and validated container endpoint.  With no proxy, this is direct egress.
    pass_proxy=True,
)
if result.get("exit_code") != 0:
    print(
        f"[playwright-cache] install_failed exit={result.get('exit_code')} "
        f"timed_out={bool(result.get('timed_out'))}",
        file=sys.stderr,
    )
    raise SystemExit(1)

if not any(path.is_file() and os.access(path, os.X_OK) for path in Path(browser_cache).rglob("chrome")):
    print("[playwright-cache] Chromium executable was not found after install", file=sys.stderr)
    raise SystemExit(1)
print("[playwright-cache] ready version=1.62.0 path=/srv/private-ci/cache/ms-playwright")
PY
