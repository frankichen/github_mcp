# 受控 Node + Chromium 运行时镜像
#
# node:22 基础镜像缺少 Chromium 运行所需系统库（libnspr4/libnss3 等），
# 导致 Playwright 浏览器 smoke 在容器内 Chrome startup 失败。本镜像在
# node:22 之上补齐 Chromium 系统依赖，供浏览器 smoke 工作区使用。
#
# Worker 只需构建一次并留在本机 rootless Podman image store：
#   podman build --pull=never -t localhost/node-chromium:22 -f Dockerfile.node-chromium .
# 不推送到远端；所有分支/worktree 复用这个本地标签。
#
# Worker 上由运维预加载（root + ciworker 存储路径），job 只读使用，不隐式 pull。

FROM docker.io/library/node:22

# Chromium 运行依赖（Debian bookworm，对齐 Playwright 官方清单）。
# 全部来自 Debian 官方源；保持最小集合，不加构建工具链。代理来自
# prepare-node-chromium 清洗后的宿主代理环境；未配置代理时保持直连。
RUN set -eu; \
    http_apt_proxy="${http_proxy:-${HTTP_PROXY:-}}"; \
    https_apt_proxy="${https_proxy:-${HTTPS_PROXY:-${http_apt_proxy}}}"; \
    set --; \
    if [ -n "${http_apt_proxy}" ]; then \
        set -- "$@" -o "Acquire::http::Proxy=${http_apt_proxy}"; \
    fi; \
    if [ -n "${https_apt_proxy}" ]; then \
        set -- "$@" -o "Acquire::https::Proxy=${https_apt_proxy}"; \
    fi; \
    apt-get "$@" update; \
    apt-get "$@" install -y --no-install-recommends \
        libnspr4 \
        libnss3 \
        libatk1.0-0 \
        libatk-bridge2.0-0 \
        libcups2 \
        libdrm2 \
        libxkbcommon0 \
        libxcomposite1 \
        libxdamage1 \
        libxfixes3 \
        libxrandr2 \
        libgbm1 \
        libasound2 \
        libpango-1.0-0 \
        libcairo2 \
        libatspi2.0-0 \
        libglib2.0-0 \
        libx11-6 \
        libxcb1 \
        libxext6 \
        libxi6 \
        libxtst6 \
        libxss1 \
        fonts-liberation; \
    rm -rf /var/lib/apt/lists/*

# 与 node:22 保持一致的工作目录与入口（CI 容器通过 --entrypoint /bin/sh 覆盖）
WORKDIR /workspace
