#!/bin/bash
set -euo pipefail

# 预热当前 Worker 的 Go 模块缓存与 Goose binary。缓存位置只通过
# PRIVATE_CI_WORKER_ID -> worker_runtime_config() 推导，禁止写旧全局目录。
#
# 背景：sxt 的 Makefile（#725）安装 goose 时使用隔离的临时 GOMODCACHE，
# 下载结果不会落 Worker cache，导致每个 CI job 都冷下载 goose 全部依赖。
# 但该 Makefile 保留 GOPROXY=file://$shared_module_cache 优先代理——只要
# Worker cache/download 里已有 goose 模块和 binary 后，job 直接本地命中。
#
# 用法（ciworker；部署为每个允许 Worker 分别设置 identity；可重复执行）：
#   PRIVATE_CI_WORKER_ID=wsl-ci-01 /srv/private-ci/agent/deploy/prepare-go-cache
#   PRIVATE_CI_WORKER_ID=wsl-ci-01 /srv/private-ci/agent/deploy/prepare-go-cache --verify-only

if [ "$(id -u)" != "1500" ]; then
    echo "[go-cache] run as ciworker (uid 1500)" >&2
    exit 2
fi

# The deployment script may invoke this as ciworker from a root-only source
# worktree. Podman must start from a directory the worker can enter.
cd /tmp

AGENT_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
RUNTIME_PROXY_CONF="$(
    PYTHONPATH="${AGENT_ROOT}" /usr/bin/python3 -m private_ci_agent.go_cache \
        --print-runtime-proxy-config
)"

if [ -r "${RUNTIME_PROXY_CONF}" ]; then
    set -a
    # shellcheck source=/dev/null
    . "${RUNTIME_PROXY_CONF}"
    set +a
fi
# Standalone maintenance runs do not inherit the systemd launcher's container
# gateway setting; slirp4netns exposes the Worker host through 10.0.2.2.
export PRIVATE_CI_CONTAINER_PROXY_HOST="${PRIVATE_CI_CONTAINER_PROXY_HOST:-10.0.2.2}"

umask 077
exec env PYTHONPATH="${AGENT_ROOT}" /usr/bin/python3 -m private_ci_agent.go_cache "$@"
