GITHUB_AUTH_MODE=classic_pat
# Prefer a mode 0600 regular file owned by the Controller runtime user.
GITHUB_TOKEN_FILE=/run/secrets/github_classic_pat
# Legacy compatibility only; ignored when GITHUB_TOKEN_FILE is set.
GITHUB_TOKEN=
# GitHub App alternative:
# GITHUB_AUTH_MODE=github_app
# GITHUB_APP_ID=123456
# GITHUB_APP_INSTALLATION_ID=12345678
# GITHUB_APP_PRIVATE_KEY_FILE=/run/secrets/github_app_private_key.pem
ACTION_API_KEY=your_hex_api_key_here
GITHUB_API_URL=https://api.github.com
# Keep MCP reads bounded during transient GitHub/network failures.
GITHUB_API_TIMEOUT_SECONDS=10
GITHUB_API_RETRY_TOTAL=1
ALLOWED_REPOSITORIES=owner/repository
# Set these only in the controlled deploy executor environment when publishing auto_gupiao.
# AUTO_GUPIAO_DEPLOY_WORKSPACE=/home/xiaowu/work/auto_gupiao
# AUTO_GUPIAO_DEPLOY_MIRROR=/home/xiaowu/work/private-deploy-cache/frankichen-auto_gupiao.git
# AUTO_GUPIAO_REPOSITORY_URL=https://github.com/frankichen/auto_gupiao.git
ALLOW_DEFAULT_BRANCH_WRITE=false
MAX_FILE_CHARACTERS=60000
MAX_TOTAL_CHARACTERS=80000
MAX_FILES_PER_COMMIT=20
LOG_LEVEL=INFO
DEPLOY_CALLBACK_API_KEY_FILE=/run/secrets/deploy_callback_api_key
