[Unit]
Description=Private CI Test Environment Deploy Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=deployworker
WorkingDirectory=/opt/private-deploy-agent
EnvironmentFile=/etc/private-ci/deploy-worker.env
Environment=DEPLOY_STATUS_FILE=/var/lib/private-ci/gongshi-test-status.json
Environment=ENVIRONMENT_URL=http://gongshi-test
Environment=DEPLOY_EXECUTION_MODE=claim_only
# auto_gupiao uses the same worker with its own fixed contract/workspace.
# Set this to the clean exact-main checkout maintained by the controlled WSL executor.
Environment=AUTO_GUPIAO_DEPLOY_WORKSPACE=/srv/private-ci/deploy-workspace/auto_gupiao
Environment=AUTO_GUPIAO_DEPLOY_STATUS_FILE=/var/lib/private-ci/auto-gupiao-status.json
ExecStart=/opt/private-deploy-agent/venv/bin/python -m app.deploy_worker
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/private-deploy-agent /var/lib/private-ci

[Install]
WantedBy=multi-user.target
