  "current_tool_contracts": {
    "start_private_ci_job": {
      "name": "start_private_ci_job",
      "description": "Durably accept a private CI Request for an exact Git commit without waiting for Worker execution.\n\nCRITICAL WORKFLOW:\n1. Supply the FULL 40-character commit_sha and a stable idempotency_key\n2. Save request_id; worker_job_id/job_id may truthfully be null while preparing\n3. Replaying the same request/key is safe; a different request with the same key conflicts\n4. Continue non-terminal tracking with get_private_ci_job snapshots; use diagnostics only when needed\n\nThis is for the private WSL CI system. NOT for GitHub Actions dispatch (use start_ci_job for that).",
      "input_schema": {
        "properties": {
          "repository": {
            "title": "Repository",
            "type": "string"
          },
          "branch": {
            "title": "Branch",
            "type": "string"
          },
          "commit_sha": {
            "title": "Commit Sha",
            "type": "string"
          },
          "profile": {
            "default": "repo-auto-check",
            "title": "Profile",
            "type": "string"
          },
          "timeout_seconds": {
            "default": 900,
            "title": "Timeout Seconds",
            "type": "integer"
          },
          "priority": {
            "default": "normal",
            "title": "Priority",
            "type": "string"
          },
          "force_rerun": {
            "default": false,
            "title": "Force Rerun",
            "type": "boolean"
          },
          "supersede_previous": {
            "default": false,
            "title": "Supersede Previous",
            "type": "boolean"
          },
          "base_sha": {
            "default": "",
            "title": "Base Sha",
            "type": "string"
          },
          "idempotency_key": {
            "default": "",
            "title": "Idempotency Key",
            "type": "string"
          }
        },
        "required": [
          "repository",
          "branch",
          "commit_sha"
        ],
        "title": "start_private_ci_jobArguments",
        "type": "object"
      },
      "output_schema": {
        "additionalProperties": true,
        "title": "start_private_ci_jobDictOutput",
        "type": "object"
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": true
      },
      "deprecated": false,
      "compatibility_only": false,
      "visibility": "canonical",
      "exposed_by_default": true,
      "deprecation": null
    },
    "get_private_ci_job": {
      "name": "get_private_ci_job",
      "description": "Get one private CI Request/Worker snapshot. Defaults to a compact gate-safe summary.\n\nProvide request_id and/or job_id; at least one is required. request_id works before a Worker Job exists.\nWhen both are supplied they must be the exact persisted Request/Worker pair or the call fails closed.\nsummary is a pure read of current durable state: it never waits, polls, calls GitHub/network, or loads logs.\nIt keeps exact identity, Request revision, truthful Worker execution status, queue/worker state,\nnormalized workspaces, and bounded step status without commands, offsets, evidence, or changed files.\nUse detail_level='full' only for debugging; oversized full results are returned through a response resource.\n\nThis is for the private CI system. NOT for GitHub Actions runs (use get_ci_job for that).",
      "input_schema": {
        "properties": {
          "job_id": {
            "default": "",
            "title": "Job Id",
            "type": "string"
          },
          "detail_level": {
            "default": "summary",
            "title": "Detail Level",
            "type": "string"
          },
          "request_id": {
            "default": "",
            "title": "Request Id",
            "type": "string"
          }
        },
        "title": "get_private_ci_jobArguments",
        "type": "object"
      },
      "output_schema": {
        "additionalProperties": true,
        "title": "get_private_ci_jobDictOutput",
        "type": "object"
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      },
      "deprecated": false,
      "compatibility_only": false,
      "visibility": "canonical",
      "exposed_by_default": true,
      "deprecation": null
    },
    "get_private_ci_logs": {
      "name": "get_private_ci_logs",
      "description": "Get private CI job execution logs by job_id. Supports pagination for large logs and precise persisted-step reads.\n\nUse the exact job_id from start_private_ci_job. Do NOT assume the latest job's logs.\n\nWithout step_id/step_name this preserves the complete job-log API. With step_id,\nor a unique step_name, only the persisted half-open step range is returned.\nstep_id is the stable selector when step names repeat. Pass next_cursor back\nas cursor for the next step page; cursor-only continuation is supported.\n\nThis is for the private CI system. NOT for GitHub Actions logs (use get_ci_logs for that).",
      "input_schema": {
        "properties": {
          "job_id": {
            "default": "",
            "title": "Job Id",
            "type": "string"
          },
          "offset": {
            "default": 0,
            "title": "Offset",
            "type": "integer"
          },
          "limit": {
            "default": 200,
            "title": "Limit",
            "type": "integer"
          },
          "step_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Step Id"
          },
          "step_name": {
            "default": "",
            "title": "Step Name",
            "type": "string"
          },
          "cursor": {
            "default": "",
            "title": "Cursor",
            "type": "string"
          }
        },
        "title": "get_private_ci_logsArguments",
        "type": "object"
      },
      "output_schema": {
        "additionalProperties": true,
        "title": "get_private_ci_logsDictOutput",
        "type": "object"
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      },
      "deprecated": false,
      "compatibility_only": false,
      "visibility": "canonical",
      "exposed_by_default": true,
      "deprecation": null
    },
    "list_private_ci_workers": {
      "name": "list_private_ci_workers",
      "description": "List workers registered with the private CI controller, including wsl-ci-01.\n\nReturns each worker's ID, online status, supported profiles, max concurrency, and current job.\n\nThis is for the private German-controller + WSL-Podman CI system.\nNOT for GitHub Actions self-hosted runners (use list_ci_workers for that).",
